# ==============================================================================
# Renova AI - Environment Configuration Example
# Copy this file to '.env' and fill in your values:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Worker Settings
# ------------------------------------------------------------------------------
ENV=dev                              # Environment mode: 'dev', 'test', or 'prod'
RUN_WORKER=true                      # Run the background job runner in the same process
HOST=127.0.0.1                       # API bind host
PORT=8000                            # API bind port

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL)
# ------------------------------------------------------------------------------
# Supports local postgres or cloud PostgreSQL (Neon, Supabase, Render Postgres)
# Driver prefixes like postgresql+asyncpg:// or postgresql+psycopg2:// are accepted
DATABASE_URL=postgresql+asyncpg://postgres:root@localhost:5432/AIRenovation
# DATABASE_TEST_URL=postgresql+asyncpg://postgres:root@localhost:5433/AIRenovation_test

# ------------------------------------------------------------------------------
# 3. AI Vision & Inpainting Services
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
JEV_API_KEY=your_jev_api_key_here

AI_PROVIDER=real                     # 'real' (Gemini + Jev) or 'fake' (mock replay for tests)
GEMINI_SEGMENT_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
JEV_MODEL=jev-latest
GEMINI_MAX_CONCURRENCY=2
JEV_MAX_CONCURRENCY=8

# ------------------------------------------------------------------------------
# 4. Storage Backend (Local Disk vs Cloud S3 / Backblaze B2)
# ------------------------------------------------------------------------------
# Choose 'local' (saves files to ./data) or 's3' (persists to cloud storage)
# If set to 's3' but credentials are missing, Renova automatically falls back to 'local'
STORAGE_BACKEND=local

# S3 Configuration (Required if STORAGE_BACKEND=s3)
# Compatible with Backblaze B2, Cloudflare R2, AWS S3, MinIO
S3_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com
S3_REGION=us-east-005
S3_BUCKET=renova-prod-files
S3_ACCESS_KEY_ID=0050c525d18bd650000000001
S3_SECRET_ACCESS_KEY=your_backblaze_application_key_here

# ------------------------------------------------------------------------------
# 5. Security, Auth & CORS
# ------------------------------------------------------------------------------
JWT_SECRET=dev-only-secret-key-change-in-production-use-random-string
JWT_TTL_HOURS=72
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SIGNUP_OPEN=true                     # Set to false to restrict access to pre-seeded accounts
# SEED_USERS={"email@example.com": "$argon2id$..."}

# ------------------------------------------------------------------------------
# 6. Usage Limits & Thresholds
# ------------------------------------------------------------------------------
DAILY_PHOTO_LIMIT=0                  # 0 = unlimited, or e.g. 10 photos per user per day (UTC)
DAILY_NEW_LOOK_LIMIT=0               # 0 = unlimited, or e.g. 15 redesigns per user per day (UTC)
MAX_UPLOAD_BYTES=15728640            # Max upload file size in bytes (default 15 MB)
WORKER_CONCURRENCY=4                 # Number of parallel background worker lanes
REGION_CONFIDENCE_THRESHOLD=0.6
RENDER_QA_THRESHOLD=0.6
RENDER_MAX_AUTO_REGENERATE=2

# ------------------------------------------------------------------------------
# 7. Logging
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO                       # DEBUG, INFO, WARNING, ERROR
LOG_JSON=true                        # Output structured JSON logs
